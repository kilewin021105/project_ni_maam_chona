# Copy this file to .env and fill in what you need. Everything is optional:
# with no settings the app uses the local SQLite database in database/bcc_guidance.db.

# ── Supabase (optional) ──
# Use the SERVICE ROLE secret key from Project Settings → API. It must stay on the server;
# never use it in browser code. Do not use the anon key here.
SUPABASE_URL=
SUPABASE_KEY=

# ── Security ──
# Long random string used to sign login sessions. If empty, one is generated and kept in .jwt_secret.
JWT_SECRET=
JWT_EXPIRATION_HOURS=12
# Only emails ending with this domain can self-register. Leave empty to allow any email.
ALLOWED_EMAIL_DOMAIN=buenavista.edu.ph
# Failed sign-ins allowed per email before a temporary lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Server ──
# 0.0.0.0 lets phones on the same Wi-Fi open the site; use 127.0.0.1 to allow this computer only.
HOST=0.0.0.0
PORT=5000
# Never set DEBUG=True on a shared network: the debugger can run code on this computer.
DEBUG=False
# Extra websites allowed to call the API (comma-separated). The bundled pages don't need this.
CORS_ORIGINS=
